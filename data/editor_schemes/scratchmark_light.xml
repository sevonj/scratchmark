<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="scratchmark_light" name="Scratchmark (Light)" version="1.0">
  <author>sevonj</author>
  <_description>Default Theme for Scratchmark</_description>

  <style name="cursor" foreground="#26928D" bold="true"/>

  <!--style name="selection" foreground="#" background="#" /-->
  <style name="search-match" foreground="#000000" background="#e5a50a77" />

  <!-- transparent bg -->
  <style name="text" background="#00000000" />

  <!-- Color: LightSeaGreen and darker shades -->
  <style name="markdown:h" foreground="#B5B4B1" />
  <style name="markdown:h1" foreground="#26928D" scale="xx-large" bold="true" />
  <style name="markdown:h2" foreground="#308C88" scale="x-large" bold="true" />
  <style name="markdown:h3" foreground="#398783" scale="large" bold="true" />
  <style name="markdown:h4" foreground="#43817F" scale="medium" bold="true" />
  <style name="markdown:h5" foreground="#4C7C7A" scale="medium" bold="true" />
  <style name="markdown:h6" foreground="#567675" scale="medium" bold="true" />
  <style name="markdown:bold" bold="true" />
  <style name="markdown:italic" italic="true" />
  <style name="markdown:bold-italic" bold="true" italic="true" />
  <style name="markdown:code" foreground="#gray" />
  <style name="markdown:strikethrough" strikethrough="true" foreground="#457173" />
  <style name="markdown:task-box" foreground="#0006" />
  <style name="markdown:task-check" foreground="#000a" />
  <style name="markdown:highlight" background="#e5a50a55" />
  <!-- TODO style name="markdown:subscript" /-->
  <!-- TODO style name="markdown:superscript" /-->

  <style name="markdown:blockquote" foreground="#gray" />
  <style name="markdown:list" foreground="#gray" />
  <style name="markdown:horizontal-rule" foreground="#gray" />
  <style name="markdown:link" foreground="#0006" />
  <style name="markdown:link-text" foreground="#308C88" />
  <style name="markdown:link-url" foreground="#0009" />
  <style name="markdown:escape" foreground="#gray" />

